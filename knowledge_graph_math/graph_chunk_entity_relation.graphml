    <node id="h">
      <data key="d0">h</data>
      <data key="d1">variable</data>
      <data key="d2">Another variable in the formula, also representing an unknown value or measurement.</data>
      <data key="d3">doc-3686830df420ce5a2ede2561e500fcdd-chunk-000</data>
