    <node id="S">
      <data key="d0">S</data>
      <data key="d1">concept</data>
      <data key="d2">The result of the mathematical expression.&lt;SEP&gt;S represents the surface area of a circle.&lt;SEP&gt;S represents the surface area of a sphere in the given formula.&lt;SEP&gt;S represents a variable in the mathematical expression.&lt;SEP&gt;S represents the result of the mathematical expression.&lt;SEP&gt;S represents the sum in the mathematical context.</data>
      <data key="d3">doc-3686830df420ce5a2ede2561e500fcdd-chunk-000&lt;SEP&gt;doc-30bb8cabb1c868341358d6696111eff8-chunk-000&lt;SEP&gt;doc-8338d84cbfe7914211255ac9d9e4b49b-chunk-000&lt;SEP&gt;doc-f205ae5d73886267042a8e0600bd6703-chunk-000&lt;SEP&gt;doc-c2dfa7e1e54f19c7c0d453b57e49d569-chunk-000&lt;SEP&gt;doc-6cf4854854a42f4041e73060e773058f-chunk-000</data>
