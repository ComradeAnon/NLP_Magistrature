      <data key="d0">b^2-4ac</data>
      <data key="d3">doc-93b6acd960d94a31188c3d66a7ec9b38-chunk-000</data>
      <data key="d2">The entire expression b squared minus 4 times a times c equals D in the given formula.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1781007354</data>
      <data key="d6" />
    </node>
