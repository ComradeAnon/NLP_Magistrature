[
  {
    "text": "Квадратное уравнение общего вида",
    "latex": "ax^2 + bx + c = 0",
    "source": "algebra_basics",
    "class": "equation"
  },
  {
    "text": "Дискриминант квадратного уравнения",
    "latex": "D = b^2 - 4ac",
    "source": "algebra_basics",
    "class": "equation"
  },
  {
    "text": "Корни квадратного уравнения через дискриминант",
