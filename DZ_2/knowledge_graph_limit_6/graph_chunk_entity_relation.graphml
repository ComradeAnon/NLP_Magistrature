    <node id="x">
      <data key="d0">x</data>
      <data key="d1">concept</data>
      <data key="d2">x is an unknown variable in the quadratic equation.&lt;SEP&gt;The variable x represents the solution to the quadratic equation.</data>
      <data key="d3">doc-aeab57fd22d9f58874a6b009381a44e6-chunk-000&lt;SEP&gt;doc-e104e211de2f2d77ed73269623c39fd2-chunk-000</data>
